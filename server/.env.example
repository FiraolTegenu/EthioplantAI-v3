# Appwrite (server-side only — never expose APPWRITE_API_KEY in the browser)

APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1

APPWRITE_PROJECT_ID=your_project_id

APPWRITE_API_KEY=your_api_key_with_storage_and_databases_scopes



APPWRITE_BUCKET_ID=your_storage_bucket_id

APPWRITE_DATABASE_ID=your_database_id

APPWRITE_COLLECTION_ID=plant_images

# Disease detections collection (create in Appwrite — see server/src/schemas/disease-detections.collection.json)

APPWRITE_DISEASE_COLLECTION_ID=disease_detections



# PlantNet (server-side only — get key at https://my.plantnet.org)

PLANTNET_API_KEY=your_plantnet_api_key

PLANTNET_PROJECT=all

PLANTNET_API_BASE=https://my-api.plantnet.org/v2



# AI Farming Assistant — Groq (server-side only — never expose GROQ_API_KEY in the browser)

GROQ_API_KEY=your_groq_api_key

AI_MODEL=llama-3.3-70b-versatile

AI_API_BASE=https://api.groq.com/openai/v1/chat/completions

# DEBUG_CHAT=1



# Server

PORT=3000

CLIENT_ORIGIN=http://localhost:3000

