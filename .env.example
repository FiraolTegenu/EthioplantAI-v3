# =============================================================================
# EthioPlantAI — Environment Variables
# Copy sections to frontend/.env and backend/.env for local development.
# Never commit .env files with real secrets.
# =============================================================================

# --- Frontend (Netlify / local Vite) — copy to frontend/.env ---
# Production: set to your Render backend URL (no trailing slash)
VITE_API_URL=https://ethioplantai-copy.onrender.com
# Local dev: leave VITE_API_URL empty; Vite proxies /api to the backend
VITE_API_PROXY_TARGET=http://localhost:3000
VITE_DEV_PORT=5173
VITE_DEBUG=false

# --- Backend (Render / local Node) — copy to backend/.env ---
APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_project_id
APPWRITE_API_KEY=your_api_key_with_storage_and_databases_scopes
APPWRITE_BUCKET_ID=your_storage_bucket_id
APPWRITE_DATABASE_ID=your_database_id
APPWRITE_COLLECTION_ID=plant_images
APPWRITE_DISEASE_COLLECTION_ID=disease_detections

PLANTNET_API_KEY=your_plantnet_api_key
PLANTNET_PROJECT=all
PLANTNET_API_BASE=https://my-api.plantnet.org/v2

GROQ_API_KEY=your_groq_api_key
AI_MODEL=llama-3.3-70b-versatile
AI_API_BASE=https://api.groq.com/openai/v1/chat/completions

PORT=3000
# Comma-separated allowed frontend origins (Netlify URL + local Vite)
CLIENT_ORIGIN=http://localhost:5173,https://your-app.netlify.app
