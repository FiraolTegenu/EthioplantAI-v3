# Backend API URL (required for production builds on Netlify)
# Production: https://ethioplantai-copy.onrender.com
# Leave empty for local dev — Vite proxies /api to the backend
VITE_API_URL=https://ethioplantai-copy.onrender.com

# Local dev: backend URL for Vite proxy (default http://localhost:3000)
VITE_API_PROXY_TARGET=http://localhost:3000

# Local dev server port (default 5173)
VITE_DEV_PORT=5173

# Enable client-side debug logging
VITE_DEBUG=false
